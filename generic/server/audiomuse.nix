{
  config,
  lib,
  pkgs,
  secretsDir,
  ...
}:

let
  cfg = config.services.audiomuse;
  backend = config.virtualisation.oci-containers.backend;

  # Scaling: the image starts exactly one default-queue worker per container
  # (plus a high-priority worker and maintenance), and each worker runs one
  # album task at a time (tracks sequential within the album). Upstream's k8s
  # manifest scales the same worker pod ("Scale as needed"); the dispatch
  # throttle MAX_QUEUED_ANALYSIS_JOBS (25) bounds how many replicas matter.
  workerNames = map (n: "worker-${toString n}") (lib.range 1 cfg.workers);
  appUnitNames = [ "flask" ] ++ workerNames;

  # Flask calls init_db() at import; supervisord gives up after 3 quick retries.
  # dependsOn orders starts but gives no readiness, so wait for accept() over
  # the loopback-published postgres port (uptime-kuma-mariadb pattern).
  # 5433, not 5432: the dawarich module enables host postgresql, which owns
  # 127.0.0.1:5432.
  #
  # This binding must stay byte-identical to the deployed pre-mTLS version:
  # systemd restarts any unit whose ExecStartPre path changes, which would
  # kill mid-analysis flask/worker containers on the next melon switch.
  waitForPostgres = pkgs.writeShellScript "audiomuse-wait-for-postgres" ''
    pg_isready="${lib.getExe' pkgs.postgresql "pg_isready"}"
    for _ in $(seq 1 90); do
      if "$pg_isready" -h 127.0.0.1 -p 5433 -U audiomuse -d audiomusedb -t 2 -q; then
        exit 0
      fi
      sleep 1
    done
    echo "timed out waiting for AudioMuse-AI PostgreSQL" >&2
    exit 1
  '';

  # On the server host the app containers reach postgres over audiomuse-net by
  # container name (aardvark DNS); a worker-only host points at the server's
  # LAN publish instead (see the options below).
  appEnvironment = {
    TZ = "America/Toronto";
    POSTGRES_USER = "audiomuse";
    POSTGRES_DB = "audiomusedb";
    POSTGRES_HOST = cfg.postgresHost;
    POSTGRES_PORT = toString cfg.postgresPort;
    TEMP_DIR = "/app/temp_audio";
  };

  # One container per replica, each with its own temp-audio and plugins dirs
  # (upstream gives each worker pod its own PVC; there TEMP_DIR is shared by
  # every worker process, so per-replica dirs also dodge the shared-wipe
  # constraint).
  workerContainer = name: {
    image = "ghcr.io/neptunehub/audiomuse-ai:latest";
    dependsOn = [ "audiomuse-postgres" ];
    environment = appEnvironment // {
      SERVICE_TYPE = "worker";
      # Upstream's default tears down and reloads both MusiCNN ONNX models
      # after every song to bound VRAM leaks (~2-3s per-track overhead).
      # CPU-only here, and each analysis job runs in a forked child that
      # os._exits (memory reclaimed at job end anyway), so recycle every
      # 20 songs instead.
      PER_SONG_MODEL_RELOAD = "false";
    };
    environmentFiles = [ config.age.secrets.audiomuse-env.path ];
    volumes = [
      "/var/lib/audiomuse/${name}/temp-audio:/app/temp_audio"
      "/var/lib/audiomuse/${name}/plugins:/app/plugin/installed"
    ];
    extraOptions = [ "--network=audiomuse-net" ];
  };

  # Public halves of the postgres mTLS setup (generated by
  # scripts/gen-audiomuse-pg-certs.sh; private keys are agenix secrets).
  # The server cert's primary SAN is DNS:melon (router DHCP-lease DNS) — the
  # worker dials "melon" with PGSSLMODE=verify-full.
  pgCertDir = ./audiomuse-pg-certs;

  # Custom hba — replaces the image's default catch-all (`host all all all
  # scram`). Allowed sources: the app containers on audiomuse-net (subnet
  # pinned in init-audiomuse-network), melon loopback (host-side pg_isready
  # wait + debugging), and mTLS workers on the home LAN /24 (client cert +
  # scram required — the cert and password are the real gate; pg_hba cannot
  # match by DNS name, so the /24 covers onion without pinning its DHCP
  # address). Every other source is denied. The docker entrypoint only
  # writes pg_hba.conf during initdb, so this mounted file is never
  # overwritten.
  pgHba = pkgs.writeText "audiomuse-pg-hba.conf" ''
    local   all  all              trust
    host    all  all  10.89.1.0/24 scram-sha-256
    host    all  all  127.0.0.1/32 scram-sha-256
    hostssl all  all  10.8.8.0/24  scram-sha-256 clientcert=verify-full
  '';

  # Runs before the postgres container starts (appended to the module's own
  # pre-start): copies the mTLS files into the pg-ssl dir the container
  # mounts. The server key must be 0600 and owned by the postgres user
  # (uid/gid 70 in postgres:15-alpine) or postgres refuses to start; the
  # public certs come straight from the store.
  installPgSsl = pkgs.writeShellScript "audiomuse-install-pg-ssl" ''
    set -e
    mkdir -p /var/lib/audiomuse/pg-ssl
    install -m 0644 -o 70 -g 70 ${pgCertDir}/ca.crt /var/lib/audiomuse/pg-ssl/ca.crt
    install -m 0644 -o 70 -g 70 ${pgCertDir}/server.crt /var/lib/audiomuse/pg-ssl/server.crt
    install -m 0600 -o 70 -g 70 ${config.age.secrets.audiomuse-pg-server-key.path} /var/lib/audiomuse/pg-ssl/server.key
  '';

  # Readiness probe for the worker-only role: a full psql login that proves
  # the TLS handshake, client-cert verification AND scram auth all succeed
  # (pg_isready cannot do any of that against a hostssl clientcert=verify-full
  # line). Runs on the host as root, so it can read the agenix env file and
  # client key directly.
  waitForRemotePostgres = pkgs.writeShellScript "audiomuse-wait-for-remote-postgres" ''
    psql="${lib.getExe' pkgs.postgresql "psql"}"
    for _ in $(seq 1 90); do
      if PGPASSWORD="$(cut -d= -f2- ${config.age.secrets.audiomuse-env.path})" \
         PGSSLMODE=verify-full \
         PGSSLROOTCERT=${pgCertDir}/ca.crt \
         PGSSLCERT=${pgCertDir}/client.crt \
         PGSSLKEY=${config.age.secrets.audiomuse-pg-client-key.path} \
         "$psql" -h ${cfg.postgresHost} -p ${toString cfg.postgresPort} -U audiomuse -d audiomusedb -tAc "select 1" >/dev/null 2>&1; then
        exit 0
      fi
      sleep 1
    done
    echo "timed out waiting for AudioMuse-AI PostgreSQL over mTLS at ${cfg.postgresHost}:${toString cfg.postgresPort}" >&2
    exit 1
  '';

  # Prebuilt .NET plugin (targetAbi 12.0.0.0 = jellyfin 10.11). Installed by
  # symlinking into jellyfin's data dir plugins folder (jellyfin loads plugins
  # from <datadir>/plugins, see BaseApplicationPaths.PluginsPath).
  audiomuseJellyfinPlugin = pkgs.stdenv.mkDerivation {
    pname = "jellyfin-plugin-audiomuse-ai";
    version = "0.3.5.0";

    src = pkgs.fetchurl {
      url = "https://github.com/NeptuneHub/audiomuse-ai-plugin/releases/download/v0.3.5/audiomuse-ai_0.3.5.0.zip";
      hash = "sha256-YrwlpLXTu2NoRVzsCXOKdPL9XjOjHfbvUzi5nzx5Tlk=";
    };

    dontUnpack = true;

    nativeBuildInputs = [ pkgs.unzip ];

    installPhase = ''
      mkdir -p $out/plugins
      unzip -q $src -d $out/plugins
    '';

    meta = {
      description = "AudioMuse-AI plugin for Jellyfin";
      homepage = "https://github.com/NeptuneHub/audiomuse-ai-plugin";
      license = lib.licenses.agpl3Only;
    };
  };
in
{
  options.services.audiomuse = {
    enable = lib.mkEnableOption "AudioMuse-AI sonic-similarity service";

    port = lib.mkOption {
      type = lib.types.port;
      default = 8000;
      readOnly = true; # gunicorn bind is fixed in the image
      description = "AudioMuse-AI HTTP port.";
    };

    workers = lib.mkOption {
      type = lib.types.ints.between 1 25;
      default = 2;
      description = ''
        Number of analysis worker replicas. Each replica runs one
        default-queue worker (one album at a time, tracks sequential;
        ~1.3 GB RAM). Upstream's dispatch throttle keeps at most 25 album
        tasks queued (MAX_QUEUED_ANALYSIS_JOBS), so more than 25 buys nothing.
        Each replica's ONNX inference is multi-threaded: 4 replicas
        oversubscribed melon's 64 cores (load ~73, 2026-10-17), hence 2.
      '';
    };

    workerOnly = lib.mkEnableOption "remote worker-only deployment: no postgres/flask; one worker container connects to a server host's postgres over the LAN";

    postgresHost = lib.mkOption {
      type = lib.types.str;
      default = "audiomuse-postgres";
      description = ''
        Hostname the app containers use to reach postgres. Server role: the
        container name over audiomuse-net. Worker-only role: the server
        host's DNS name ("melon" — the router's DHCP-lease DNS, which
        auto-tracks the IP; containers have no mDNS, so a .local name would
        not resolve from the worker container).
      '';
    };

    postgresPort = lib.mkOption {
      type = lib.types.port;
      default = 5432;
      description = ''
        Port for postgresHost. Server role: the in-container postgres port.
        Worker-only role: the server host's LAN publish (5433).
      '';
    };
  };

  config = lib.mkMerge [
    { services.audiomuse.enable = lib.mkDefault true; }
    (lib.mkIf cfg.enable {
      # Shared by both roles: a worker-only host still needs the postgres
      # password and the mTLS client key (secrets.nix rekeys them for every
      # host's system key).
      age.secrets = {
        audiomuse-env = {
          file = secretsDir + /audiomuse-env.age;
          owner = "root";
          group = "root";
          mode = "0400";
        };
        audiomuse-pg-server-key = {
          file = secretsDir + /audiomuse-pg-server-key.age;
          owner = "root";
          group = "root";
          mode = "0400";
        };
        audiomuse-pg-client-key = {
          file = secretsDir + /audiomuse-pg-client-key.age;
          owner = "root";
          group = "root";
          mode = "0400";
        };
      };
    })
    (lib.mkIf (cfg.enable && !cfg.workerOnly) {
      systemd = {
        tmpfiles.rules = [
          "d /var/lib/audiomuse 0755 root root -"
          # postgres:15-alpine runs postgres as uid/gid 70 (999 is the Debian
          # image's uid); a wrong owner breaks the live data dir on every switch
          # (docs/issues/14-forgejo-tmpfiles-ownership-mismatch.md). No "Z" rule:
          # systemd refuses it with "unsafe path transition" — dead code there.
          "d /var/lib/audiomuse/postgres 0700 70 70 -"
          # mTLS files live here, populated by the postgres unit's
          # ExecStartPre installPgSsl before each container start.
          "d /var/lib/audiomuse/pg-ssl 0700 70 70 -"
          "d /var/lib/audiomuse/flask/temp-audio 0700 root root -"
          "d /var/lib/audiomuse/flask/plugins 0700 root root -"
        ]
        ++ map (name: "d /var/lib/audiomuse/${name}/temp-audio 0700 root root -") workerNames
        ++ map (name: "d /var/lib/audiomuse/${name}/plugins 0700 root root -") workerNames
        ++ [
          # Jellyfin loads plugins from <datadir>/plugins; symlink the
          # AudioMuse-AI plugin in. The d rule creates the dir at switch time
          # so the L+ rules succeed even before jellyfin's first start.
          "d /var/lib/jellyfin/plugins 0755 ${config.services.jellyfin.user} ${config.services.jellyfin.group} -"
        ]
        ++
          map
            (file: "L+ /var/lib/jellyfin/plugins/${file} - - - - ${audiomuseJellyfinPlugin}/plugins/${file}")
            [
              "Jellyfin.Plugin.AudioMuseAi.dll"
              "meta.json"
              "audiomuseai.png"
            ];

        # Dedicated bridged network (bookorbit init-*-network pattern).
        # The flask and worker overrides are identical, so both are generated
        # from one expression (also keeps statix's repeated-key lint quiet).
        services = {
          init-audiomuse-network =
            let
              bin = if backend == "podman" then "${pkgs.podman}/bin/podman" else "${pkgs.docker}/bin/docker";
            in
            {
              description = "Create isolated AudioMuse-AI ${backend} Network";
              after = [ "${backend}.service" ];
              requires = [ "${backend}.service" ];
              wantedBy = [ "multi-user.target" ];
              serviceConfig.Type = "oneshot";
              script = ''
                # Subnet pinned so the pg_hba 10.89.1.0/24 line above is
                # deterministic on fresh deploys (matches the live network).
                ${bin} network inspect audiomuse-net >/dev/null 2>&1 || \
                ${bin} network create audiomuse-net --subnet 10.89.1.0/24
              '';
            };

          # Restart jellyfin when the AudioMuse plugin package changes (first
          # switch with this trigger also restarts it, loading the plugin).
          jellyfin.restartTriggers = [ audiomuseJellyfinPlugin ];

          # Postgres gets the mTLS-file install instead of the pg_isready
          # wait (probing itself in its own ExecStartPre would deadlock).
          "${backend}-audiomuse-postgres" = {
            serviceConfig.ExecStartPre = lib.mkAfter [ installPgSsl ];
          };
        }
        // lib.genAttrs (map (name: "${backend}-audiomuse-${name}") appUnitNames) (_: {
          # dependsOn gives After/Requires only; upholds re-queues a
          # dependency-failed start job (forgejo outage precedent,
          # docs/reports/2026-09-27-forgejo-dependency-outage.md).
          # The module sets TimeoutStartSec=0, so the 90s wait is safe;
          # mkAfter appends after the module's own pre-start script.
          after = [ "init-audiomuse-network.service" ];
          requires = [ "init-audiomuse-network.service" ];
          upholds = [ "${backend}-audiomuse-postgres.service" ];
          serviceConfig.ExecStartPre = lib.mkAfter [ waitForPostgres ];
        });
      };

      virtualisation.oci-containers.containers = {
        audiomuse-postgres = {
          image = "postgres:15-alpine";
          # The docker entrypoint execs a custom postgres command verbatim
          # (gosu postgres), so -c flags turn on TLS and point at the mounted
          # certs and hba.
          cmd = [
            "postgres"
            "-c"
            "ssl=on"
            "-c"
            "ssl_cert_file=/pg-ssl/server.crt"
            "-c"
            "ssl_key_file=/pg-ssl/server.key"
            "-c"
            "ssl_ca_file=/pg-ssl/ca.crt"
            "-c"
            "hba_file=/pg-hba/pg_hba.conf"
          ];
          environment = {
            TZ = "America/Toronto";
            POSTGRES_USER = "audiomuse";
            POSTGRES_DB = "audiomusedb";
          };
          environmentFiles = [ config.age.secrets.audiomuse-env.path ];
          volumes = [
            "/var/lib/audiomuse/postgres:/var/lib/postgresql/data"
            "/var/lib/audiomuse/pg-ssl:/pg-ssl"
            "${pgHba}:/pg-hba/pg_hba.conf:ro"
          ];
          # Published on all interfaces, but the custom pg_hba denies every
          # source except the app containers, melon loopback, and onion's
          # mTLS-certified worker — the rest of the LAN is rejected outright.
          # Host-side 5433: 127.0.0.1:5432 is taken by the host postgresql
          # service (auto-enabled by the dawarich module).
          ports = [ "5433:5432" ];
          extraOptions = [
            "--network=audiomuse-net"
            # podman stop's 10s default SIGKILLs postgres mid fast-shutdown
            # (docs/issues/12-postgres-unclean-shutdown.md).
            "--stop-timeout=90"
          ];
        };

        audiomuse-flask = {
          image = "ghcr.io/neptunehub/audiomuse-ai:latest";
          dependsOn = [ "audiomuse-postgres" ];
          environment = appEnvironment // {
            SERVICE_TYPE = "flask";
          };
          environmentFiles = [ config.age.secrets.audiomuse-env.path ];
          ports = [ "127.0.0.1:${toString cfg.port}:8000" ];
          volumes = [
            "/var/lib/audiomuse/flask/temp-audio:/app/temp_audio"
            "/var/lib/audiomuse/flask/plugins:/app/plugin/installed"
          ];
          extraOptions = [ "--network=audiomuse-net" ];
        };

      }
      // lib.listToAttrs (
        map (name: lib.nameValuePair "audiomuse-${name}" (workerContainer name)) workerNames
      );
    })
    (lib.mkIf (cfg.enable && cfg.workerOnly) {
      systemd = {
        tmpfiles.rules = [
          "d /var/lib/audiomuse 0755 root root -"
          "d /var/lib/audiomuse/worker-1/temp-audio 0700 root root -"
          "d /var/lib/audiomuse/worker-1/plugins 0700 root root -"
        ];

        services."${backend}-audiomuse-worker-1" = {
          # The remote postgres lives on the LAN; wait for the network before
          # probing it (Restart=on-failure still requeues if the server is
          # down at boot). The probe is a full mTLS login, not pg_isready.
          after = [ "network-online.target" ];
          serviceConfig.ExecStartPre = lib.mkAfter [ waitForRemotePostgres ];
        };
      };

      # No custom network: the worker only makes outbound connections to the
      # server host's postgres, so the default podman bridge suffices.
      virtualisation.oci-containers.containers."audiomuse-worker-1" = {
        image = "ghcr.io/neptunehub/audiomuse-ai:latest";
        environment = appEnvironment // {
          SERVICE_TYPE = "worker";
          PER_SONG_MODEL_RELOAD = "false";
          # mTLS for the LAN postgres connection: psycopg2 (libpq) picks up
          # the PGSSL* env vars automatically. verify-full checks the server
          # cert against ca.crt and the client cert is required by pg_hba
          # (clientcert=verify-full).
          PGSSLMODE = "verify-full";
          PGSSLROOTCERT = "/pg-client/ca.crt";
          PGSSLCERT = "/pg-client/client.crt";
          PGSSLKEY = "/pg-client/client.key";
        };
        environmentFiles = [ config.age.secrets.audiomuse-env.path ];
        volumes = [
          "/var/lib/audiomuse/worker-1/temp-audio:/app/temp_audio"
          "/var/lib/audiomuse/worker-1/plugins:/app/plugin/installed"
          "${pgCertDir}/ca.crt:/pg-client/ca.crt:ro"
          "${pgCertDir}/client.crt:/pg-client/client.crt:ro"
          "${config.age.secrets.audiomuse-pg-client-key.path}:/pg-client/client.key:ro"
        ];
      };
    })
  ];
}
